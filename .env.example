# Port hôte exposé par docker compose (le conteneur écoute toujours sur 80).
VERS_PORT=8080
# Interface d'écoute sur l'hôte : boucle locale par défaut ; 0.0.0.0 pour ouvrir au réseau (sans proxy).
VERS_BIND=127.0.0.1
# Nombre maximal de salons simultanés du mode en ligne (service vers-server).
VERS_MAX_ROOMS=200
# Connexions WebSocket simultanées par adresse IP (0 = illimité).
VERS_MAX_CONN_PER_IP=12
# Origines autorisées à ouvrir le WebSocket, séparées par des virgules (vide = même hôte que la page ; * = toutes).
VERS_ALLOWED_ORIGINS=
# Délai (ms) pendant lequel la place d'un joueur déconnecté est gardée avant son remplacement par l'IA.
VERS_GRACE_MS=20000
